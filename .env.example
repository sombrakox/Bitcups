# Variáveis de ambiente do servidor (NUNCA enviar .env ao Git)
PORT=10000
APP_URL=https://www.seudominio.com.br
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bitcups
DB_USER=bitcups_app
DB_PASSWORD=ALTERE_LOCALMENTE
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=465
SMTP_USER=contato@seudominio.com.br
SMTP_PASSWORD=ALTERE_LOCALMENTE
SMTP_FROM="BitCups <contato@seudominio.com.br>"

# Diretório persistente de imagens na hospedagem (configurar fora da pasta substituída no deploy)
UPLOAD_DIR=./uploads
